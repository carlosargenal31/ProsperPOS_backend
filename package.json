{
  "name": "prosperpos-backend",
  "version": "1.0.0",
  "description": "Sistema de Punto de Venta con Facturación Electrónica para Honduras",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dev:debug": "nodemon --inspect server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "build": "npm install --production",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "db:backup": "node scripts/backup.js",
    "logs:clear": "rm -rf logs/*.log",
    "setup": "node setup-project.js",
    "gcs:test": "node scripts/test-gcs-upload.js",
    "gcs:migrate": "node scripts/migrate-images-to-gcs.js",
    "cloudsql:test": "node scripts/test-cloud-sql-connection.js"
  },
  "keywords": [
    "pos",
    "point-of-sale",
    "facturacion-electronica",
    "honduras",
    "inventario",
    "nodejs",
    "express",
    "mysql"
  ],
  "author": "ProsperPOS Team",
  "license": "MIT",
  "dependencies": {
    "@google-cloud/storage": "^7.18.0",
    "axios": "^1.6.2",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "bull": "^4.12.2",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-fileupload": "^1.4.3",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.3.0",
    "helmet": "^7.2.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "moment-timezone": "^0.5.44",
    "morgan": "^1.10.1",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.15.3",
    "nodemailer": "^6.9.8",
    "pdfkit": "^0.14.0",
    "puppeteer": "^21.6.1",
    "qrcode": "^1.5.3",
    "redis": "^4.6.12",
    "sharp": "^0.33.5",
    "tesseract.js": "^6.0.1",
    "uuid": "^9.0.1",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^4.7.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "supertest": "^6.3.4"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tu-usuario/prosperpos-backend.git"
  },
  "bugs": {
    "url": "https://github.com/tu-usuario/prosperpos-backend/issues"
  },
  "homepage": "https://github.com/tu-usuario/prosperpos-backend#readme",
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/**/*.test.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ]
  }
}
