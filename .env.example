# ===================================================================
# ProsperPOS - Backend (copiar a .env y completar). NO subir .env a git.
# ===================================================================
NODE_ENV=development
PORT=3000
TZ=America/Tegucigalpa
API_PREFIX=/api/v1

# Base de datos MySQL: usar DATABASE_URL (Railway) o las variables DB_*
# DATABASE_URL=mysql://usuario:clave@host:3306/prosperpos
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=prosperpos
DB_CONNECTION_LIMIT=10

# Seguridad (generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=cambiar_por_un_valor_largo_y_aleatorio
JWT_EXPIRE=24h
JWT_REFRESH_EXPIRE=7d

# Orígenes permitidos (CORS)
FRONTEND_URL=http://localhost:3001
ECOMMERCE_URL=http://localhost:3002
# CORS_ORIGINS=https://pos.midominio.com,https://tienda.midominio.com

# Límites
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=1000

# Logs
LOG_LEVEL=info
LOG_TO_FILE=false
DEBUG_LOG=false
LOG_SQL=false

# Correo (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Empresa / facturación
DEFAULT_CURRENCY=HNL
DEFAULT_TAX_RATE=15
COMPANY_RTN=

# Opciones
ENABLE_AUDIT=true
ENABLE_BACKUP=false
ENABLE_EMAIL_NOTIFICATIONS=false
ALLOW_REGISTRATION=false

# Google (inicio de sesión de clientes en la tienda)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Cloud Storage (imágenes)
GCP_PROJECT_ID=
GCS_BUCKET_NAME=
IMAGE_BASE_URL=
# Local: ruta al archivo JSON de la cuenta de servicio
GCS_KEYFILE_PATH=./prosperpos-credentials.json
# Producción: pegar el contenido completo del JSON en una sola variable
# GCS_CREDENTIALS_JSON={"type":"service_account",...}
